# CORE
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=arxiv_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_ARXIV_TABLE=arxiv_meta
POSTGRES_RESUMABLES_TABLE=resumables

# see https://sbert.net/docs/sentence_transformer/pretrained_models.html#original-models for a full list
EMBEDDING_MODEL_NAME='sentence-transformers/all-mpnet-base-v2'

# ETL
ETL__EMBEDDING_MODEL_DIM=768
ETL__MODEL_BATCH_SIZE=130
ETL__PYTORCH_DEVICE=cuda # cuda or cpu

ETL__ARXIV_OAIMPH_URL=https://oaipmh.arxiv.org/oai

ETL__LOG_LEVEL=INFO
ETL__TIMEZONE=Europe/Madrid

# API
API__MIN_DB_CONNECTIONS=1
API__MAX_DB_CONNECTIONS=10
API__PYTORCH_DEVICE=cuda
API__ENABLE_EMBEDDING_BATCHING=True
API__EMBEDDING_MAX_LATENCY_S=.05
API__EMBEDDING_MAX_BATCH_SIZE_S=50
